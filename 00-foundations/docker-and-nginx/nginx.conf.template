# 最小可用反代片段。替换 <UPSTREAM_HOST>、<UPSTREAM_PORT>、<SERVER_NAME> 后使用。
upstream brm_app {
    server <UPSTREAM_HOST>:<UPSTREAM_PORT> max_fails=3 fail_timeout=10s;
    keepalive 32;
}

server {
    listen 80;
    server_name <SERVER_NAME>;

    client_max_body_size 10m;
    proxy_connect_timeout 2s;
    proxy_read_timeout 10s;
    proxy_send_timeout 10s;

    access_log /var/log/nginx/brm.access.log;

    location / {
        proxy_pass http://brm_app;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For  $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection       "";

        # trace id：没有则由 Nginx 生成，保证全链路一定有一个 id
        set $req_id $http_x_request_id;
        if ($req_id = "") { set $req_id $request_id; }
        proxy_set_header X-Request-ID $req_id;
        add_header      X-Request-ID $req_id always;
    }

    location = /healthz {
        proxy_pass http://brm_app;
        access_log off;
    }

    location = /readyz {
        proxy_pass http://brm_app;
        access_log off;
    }
}
